NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
# Disposable demo storage. Use postgres for durable data.
PERSISTENCE=memory
# Set PERSISTENCE=postgres and uncomment this after pnpm db:up:
# DATABASE_URL=postgresql://app:local-development-only@127.0.0.1:5432/web_platform
DOCS_ENABLED=true
