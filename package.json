{
  "name": "web-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "turbo run build --filter='./packages/*' && turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "eslint . --max-warnings=0 && pnpm boundaries",
    "boundaries": "node scripts/check-boundaries.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run build --filter=@repo/api && pnpm --filter @repo/api test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:up": "docker compose up -d db",
    "db:generate": "pnpm --filter @repo/api db:generate",
    "db:migrate": "pnpm --filter @repo/api db:migrate"
  },
  "devDependencies": {
    "@repo/tooling": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
