NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
# Disposable demo storage. Use postgres for durable data.
PERSISTENCE=memory
# Set PERSISTENCE=postgres and uncomment this after pnpm db:up:
# DATABASE_URL=postgresql://app:local-development-only@127.0.0.1:5432/web_platform
DOCS_ENABLED=true

# Development generates an ephemeral access-token signing key when unset.
# Production must supply a private key of at least 32 characters.
# JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_SECURE=false
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4000,http://127.0.0.1:4000

# Optional private S3-compatible bucket. Requires PERSISTENCE=postgres.
# Omit ENDPOINT for AWS S3; use your provider's endpoint for R2 or other compatible stores.
# S3_BUCKET=private-workspace-media
# S3_REGION=us-east-1
# S3_ENDPOINT=https://your-s3-endpoint.example
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Verification/reset links use this configured browser origin, never a caller's Host.
EMAIL_WEB_ORIGIN=http://localhost:3000
EMAIL_FROM=no-reply@example.test
# file = private local inbox in apps/api/output/mail. Production requires smtp.
MAIL_TRANSPORT=file
MAIL_OUTPUT_DIR=output/mail
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
# SMTP_USER=
# SMTP_PASSWORD=
# For a local SMTP catcher only, SMTP_REQUIRE_TLS=false is allowed outside production.
